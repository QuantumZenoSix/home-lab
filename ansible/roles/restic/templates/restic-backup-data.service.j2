# Managed by Ansible from ansible/roles/restic/templates/restic-backup-data.service.j2. Edit that file, not this one.
[Unit]
Description=Restic backup of the primary data drive (local repo, then B2)
Documentation=https://github.com/QuantumZenoSix/home-lab/blob/main/docs/backups-and-recovery.md
Wants=network-online.target
After=network-online.target
# Fail instead of snapshotting an empty mount point, which forget would
# otherwise count as one of the daily snapshots it keeps.
RequiresMountsFor={{ homelab_primary_mount }}

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/restic_backup_data.sh
TimeoutStartSec=20h
Nice=10
IOSchedulingClass=idle
